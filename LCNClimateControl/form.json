{
  "elements": [
    {
      "type": "Label",
      "caption": "HEIZEN bleibt unveraendert (LCN-Regler / GT8 A7/A8). KUEHLEN wird erst nach 11 bestandenen S1-Tests, 11 Ventilrelaistests und nachgewiesenem Hardware-Taupunktschutz freigegeben. Kein ungepruefter A7/A8-Kuehlrueckfall."
    },
    {
      "type": "List",
      "name": "Rooms",
      "caption": "Räume",
      "rowCount": 11,
      "add": true,
      "delete": true,
      "changeOrder": true,
      "columns": [
        {
          "caption": "Aktiv",
          "name": "Enabled",
          "width": "60px",
          "add": true,
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "caption": "Raum",
          "name": "Name",
          "width": "160px",
          "add": "",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "LCN-Sendemodul",
          "name": "SendModule",
          "width": "210px",
          "add": 0,
          "edit": {
            "type": "SelectInstance",
            "validModules": [
              "{0E31FED6-E465-4621-95D4-AAF2683C41EC}"
            ]
          }
        },
        {
          "caption": "Isttemperatur",
          "name": "TemperatureVariable",
          "width": "210px",
          "add": 0,
          "edit": {
            "type": "SelectVariable",
            "validVariableTypes": [
              2
            ]
          }
        },
        {
          "caption": "S1Target Float",
          "name": "TargetVariable",
          "width": "210px",
          "add": 0,
          "edit": {
            "type": "SelectVariable",
            "validVariableTypes": [
              2
            ]
          }
        },
        {
          "caption": "Tabelle",
          "name": "Table",
          "width": "85px",
          "add": "A",
          "edit": {
            "type": "Select",
            "options": [
              {
                "caption": "A",
                "value": "A"
              },
              {
                "caption": "B",
                "value": "B"
              },
              {
                "caption": "C",
                "value": "C"
              },
              {
                "caption": "D",
                "value": "D"
              }
            ]
          }
        },
        {
          "caption": "Öffnen +1 °C",
          "name": "UpKey",
          "width": "105px",
          "add": 7,
          "edit": {
            "type": "NumberSpinner",
            "minimum": 1,
            "maximum": 8
          }
        },
        {
          "caption": "Schließen -1 °C",
          "name": "DownKey",
          "width": "110px",
          "add": 8,
          "edit": {
            "type": "NumberSpinner",
            "minimum": 1,
            "maximum": 8
          }
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Kuehlen – Sicherheit und native Relais (Inbetriebnahme)",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "DirectCoolingEnabled",
          "caption": "Direkte Kuehlsteuerung verwenden (nur nach vollstaendiger Inbetriebnahme)"
        },
        {
          "type": "SelectVariable",
          "name": "CoolingSafetyVariable",
          "caption": "PFLICHT: Externe Kuehlfreigabe (Boolean TRUE = Freigabe; FALSE = sofort sperren)",
          "validVariableTypes": [
            0
          ]
        },
        {
          "type": "CheckBox",
          "name": "CoolingHardwareInterlockConfirmed",
          "caption": "PFLICHT: Unabhaengiger Taupunktwaechter sperrt Kaltwasser physisch – vor Ort geprueft"
        },
        {
          "type": "Label",
          "caption": "Ohne Kuehlfreigabe UND abgenommenen Hardware-Taupunktwaechter bleibt KUEHLEN gesperrt. LCN-S1-Pruefung und Einzelrelaispruefung nur im HEIZEN-Modus; bei Relaistest wird das einzelne Ventil kurz bestromt und danach wieder abgeschaltet. Bei Fehlern STOP statt A7/A8-Rueckfall."
        },
        {
          "type": "Label",
          "caption": "NC-Stellantriebe: Relais EIN = Ventil AUF, AUS = Ventil ZU. Die elf LCN-Relais-Units und S1TargetLock werden aus ihren nativen Symcon-Instanzen zugeordnet. Die echte Stellung muss fuer jede Unit separat bestaetigt werden."
        },
        {
          "type": "List",
          "name": "CoolingRelays",
          "caption": "Manuelle Zuordnung (normalerweise leer lassen – wird automatisch erkannt)",
          "rowCount": 11,
          "add": true,
          "delete": true,
          "changeOrder": true,
          "columns": [
            {
              "caption": "S1Target-ID",
              "name": "TargetVariable",
              "width": "105px",
              "add": 0,
              "edit": {
                "type": "SelectVariable",
                "validVariableTypes": [
                  2
                ]
              }
            },
            {
              "caption": "Relais-LCN-Modul",
              "name": "RelayModule",
              "width": "170px",
              "add": 0,
              "edit": {
                "type": "SelectInstance",
                "validModules": [
                  "{0E31FED6-E465-4621-95D4-AAF2683C41EC}"
                ]
              }
            },
            {
              "caption": "Relais R1-R8",
              "name": "RelayChannel",
              "width": "110px",
              "add": 0,
              "edit": {
                "type": "NumberSpinner",
                "minimum": 1,
                "maximum": 8
              }
            },
            {
              "caption": "Regler Index R1=0/S1=2",
              "name": "RegulatorIndex",
              "width": "120px",
              "add": -1,
              "edit": {
                "type": "Select",
                "options": [
                  {
                    "caption": "Ungeprueft",
                    "value": -1
                  },
                  {
                    "caption": "R1 (0)",
                    "value": 0
                  },
                  {
                    "caption": "S1 (2)",
                    "value": 2
                  }
                ]
              }
            },
            {
              "caption": "Entriegelt Bool",
              "name": "UnlockedVariable",
              "width": "170px",
              "add": 0,
              "edit": {
                "type": "SelectVariable",
                "validVariableTypes": [
                  0
                ]
              }
            },
            {
              "caption": "Relaisstatus Bool",
              "name": "RelayStatusVariable",
              "width": "170px",
              "add": 0,
              "edit": {
                "type": "SelectVariable",
                "validVariableTypes": [
                  0
                ]
              }
            },
            {
              "caption": "Relais EIN = Ventil AUF",
              "name": "OpenRelayOn",
              "width": "125px",
              "add": false,
              "edit": {
                "type": "CheckBox"
              }
            },
            {
              "caption": "Polaritaet vor Ort bestaetigt",
              "name": "PolarityConfirmed",
              "width": "160px",
              "add": false,
              "edit": {
                "type": "CheckBox"
              }
            }
          ]
        },
        {
          "type": "Label",
          "caption": "Bei fehlenden Relais-Units in der Modulkonfiguration einmal 'Fehlende LCN-Relais-Units anlegen' klicken. Das erstellt nur native Symcon-Relaisinstanzen fuer M92/M192; keine LCN-PRO-Aenderung und keine Relaisbefehle. Die bestehende A7/A8-Heiz- und Kuehlsteuerung bleibt bis zu erfolgreich bestaetigten Rueckmeldungen aktiv."
        }
      ]
    },
    {
      "type": "Label",
      "caption": "S1Target: In der nativen Symcon-Instanz „LCN Variable / LCN Wert“ des jeweiligen neuen LCN-Moduls ausschließlich S1Target aktivieren und hier die Float-Variable „Zieltemperatur S1“ auswählen. Die zusätzlich erzeugte Boolean-Variable „Entriegelt“ nicht auswählen."
    },
    {
      "type": "ExpansionPanel",
      "caption": "Erweiterte Ablaufparameter",
      "expanded": false,
      "items": [
        {
          "type": "NumberSpinner",
          "name": "StepWaitMs",
          "caption": "Mindestwartezeit je Raum nach Tastendruck",
          "minimum": 900,
          "maximum": 3000,
          "suffix": " ms"
        },
        {
          "type": "NumberSpinner",
          "name": "MaxSteps",
          "caption": "Maximale Tastendrücke je Auftrag (Sicherheitsgrenze)",
          "minimum": 15,
          "maximum": 50
        },
        {
          "type": "NumberSpinner",
          "name": "NoChangeConfirmations",
          "caption": "Unveränderte bestätigte Schritte bis Kühl-Endlage",
          "minimum": 2,
          "maximum": 4
        }
      ]
    },
    {
      "type": "Label",
      "caption": "LCN-Bus: Befehle und aktive Rueckfragen aus diesem Modul werden mit mindestens 750 ms Abstand ausgefuehrt. Keine dauerhafte zusaetzliche Polling-Last."
    },
    {
      "type": "Label",
      "caption": "Heizen: A7/A8 und S1Target unveraendert. Kuehlen: nach Regler-/Relaisabnahme ausschliesslich S1TargetLock via RequestAction, dann bestaetigtes Einzelrelais, vor Heizbetrieb erst Relais AUS und Regler FREI."
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Laufenden Auftrag abbrechen",
      "onClick": "LCNC_Abort($id);"
    },
    {
      "type": "Button",
      "caption": "Fehlerstatus quittieren",
      "onClick": "LCNC_ClearError($id);"
    },
    {
      "type": "Button",
      "caption": "LCN-Reglersperren: Zustand und Aktualisierung aller 11 Räume anzeigen",
      "onClick": "echo LCNC_CoolingLockStatusReport($id);"
    },
    {
      "type": "Button",
      "caption": "Interne Reglersperr-Vormerkungen prüfen und bereinigen (nur Software, keine LCN-Befehle)",
      "onClick": "echo LCNC_ReconcileUncertainCoolingLocks($id);"
    },
    {
      "type": "Button",
      "caption": "M11 EG Büro: Sperrtest-Status anzeigen (nur lesen)",
      "onClick": "echo LCNC_M11ProbeStatus($id);"
    },
    {
      "type": "Button",
      "caption": "Inbetriebnahme: naechsten S1-Regler pruefen (ein Raum, automatisch freigeben)",
      "onClick": "echo LCNC_CoolingCommissionStartNext($id);"
    },
    {
      "type": "Button",
      "caption": "Inbetriebnahme: naechstes Ventilrelais testen (kurz EIN/AUS; HEIZEN)",
      "onClick": "echo LCNC_CoolingCommissionStartRelay($id);"
    },
    {
      "type": "Button",
      "caption": "Inbetriebnahme: 11 Regler, 11 Relais und Kuehlfreigabe anzeigen (nur lesen)",
      "onClick": "echo LCNC_CoolingCommissionStatus($id);"
    },
    {
      "type": "Button",
      "caption": "NOT-AUS/FREIGABE: aktives Testventil AUS, dann S1 FREIGEBEN",
      "onClick": "echo LCNC_CoolingCommissionEmergencyRelease($id);"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Aktiv"
    },
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Keine aktiven Räume konfiguriert"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "Konfiguration fehlerhaft"
    },
    {
      "code": 202,
      "icon": "error",
      "caption": "Letzter LCN-Auftrag fehlgeschlagen"
    }
  ]
}
