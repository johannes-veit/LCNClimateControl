{
  "elements": [
    {
      "type": "Label",
      "caption": "Eine Instanz steuert alle Raeume. Heizbetrieb: LCN bleibt Master, Symcon sendet nur die vorhandenen TS-Tasten. Direkte Kuehlung ist eine zusaetzliche, standardmaessig deaktivierte Testfunktion mit zwingenden Rueckmeldungen und externer Freigabe."
    },
    {
      "type": "List",
      "name": "Rooms",
      "caption": "Räume",
      "rowCount": 10,
      "add": true,
      "delete": true,
      "changeOrder": true,
      "columns": [
        {
          "caption": "Aktiv",
          "name": "Enabled",
          "width": "60px",
          "add": true,
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "caption": "Raum",
          "name": "Name",
          "width": "160px",
          "add": "",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "LCN-Sendemodul",
          "name": "SendModule",
          "width": "210px",
          "add": 0,
          "edit": {
            "type": "SelectInstance",
            "validModules": [
              "{0E31FED6-E465-4621-95D4-AAF2683C41EC}"
            ]
          }
        },
        {
          "caption": "Isttemperatur",
          "name": "TemperatureVariable",
          "width": "210px",
          "add": 0,
          "edit": {
            "type": "SelectVariable",
            "validVariableTypes": [
              2
            ]
          }
        },
        {
          "caption": "S1Target Float",
          "name": "TargetVariable",
          "width": "210px",
          "add": 0,
          "edit": {
            "type": "SelectVariable",
            "validVariableTypes": [
              2
            ]
          }
        },
        {
          "caption": "Tabelle",
          "name": "Table",
          "width": "85px",
          "add": "A",
          "edit": {
            "type": "Select",
            "options": [
              {
                "caption": "A",
                "value": "A"
              },
              {
                "caption": "B",
                "value": "B"
              },
              {
                "caption": "C",
                "value": "C"
              },
              {
                "caption": "D",
                "value": "D"
              }
            ]
          }
        },
        {
          "caption": "Öffnen +1 °C",
          "name": "UpKey",
          "width": "105px",
          "add": 7,
          "edit": {
            "type": "NumberSpinner",
            "minimum": 1,
            "maximum": 8
          }
        },
        {
          "caption": "Schließen -1 °C",
          "name": "DownKey",
          "width": "110px",
          "add": 8,
          "edit": {
            "type": "NumberSpinner",
            "minimum": 1,
            "maximum": 8
          }
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Automatische Direktkuehlung (optional, sicherer Rueckfall)",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "DirectCoolingEnabled",
          "caption": "Direkte Relaiskuehlung aktivieren (nur nach Inbetriebnahmepruefung)"
        },
        {
          "type": "SelectVariable",
          "name": "CoolingSafetyVariable",
          "caption": "Externe Kuehlfreigabe Boolean (TRUE = sicher/freigegeben)",
          "validVariableTypes": [
            0
          ]
        },
        {
          "type": "Label",
          "caption": "Symcon prueft bei Kuehlen pro Raum LCN-Funktionen und Rueckmeldungen. Ohne neue Konfiguration bleibt die alte TS-Kuehlung mit Hinweis aktiv. Bei Direktfehlern: alte Methode erst nach bestaetigter Reglerfreigabe. Bei unklarer Freigabe STOP. Hardware-Taupunktschutz weiterhin erforderlich."
        },
        {
          "type": "List",
          "name": "CoolingRelays",
          "caption": "Eine Zuordnung je Raum (S1Target-ID aus Raeume-Liste)",
          "rowCount": 11,
          "add": true,
          "delete": true,
          "changeOrder": true,
          "columns": [
            {
              "caption": "S1Target-ID",
              "name": "TargetVariable",
              "width": "105px",
              "add": 0,
              "edit": {
                "type": "SelectVariable",
                "validVariableTypes": [
                  2
                ]
              }
            },
            {
              "caption": "Relais-LCN-Modul",
              "name": "RelayModule",
              "width": "170px",
              "add": 0,
              "edit": {
                "type": "SelectInstance",
                "validModules": [
                  "{0E31FED6-E465-4621-95D4-AAF2683C41EC}"
                ]
              }
            },
            {
              "caption": "Relais R1-R8",
              "name": "RelayChannel",
              "width": "110px",
              "add": 0,
              "edit": {
                "type": "NumberSpinner",
                "minimum": 1,
                "maximum": 8
              }
            },
            {
              "caption": "Regler Index R1=0/S1=2",
              "name": "RegulatorIndex",
              "width": "120px",
              "add": -1,
              "edit": {
                "type": "Select",
                "options": [
                  {
                    "caption": "Ungeprueft",
                    "value": -1
                  },
                  {
                    "caption": "R1 (0)",
                    "value": 0
                  },
                  {
                    "caption": "S1 (2)",
                    "value": 2
                  }
                ]
              }
            },
            {
              "caption": "Entriegelt Bool",
              "name": "UnlockedVariable",
              "width": "170px",
              "add": 0,
              "edit": {
                "type": "SelectVariable",
                "validVariableTypes": [
                  0
                ]
              }
            },
            {
              "caption": "Relaisstatus Bool",
              "name": "RelayStatusVariable",
              "width": "170px",
              "add": 0,
              "edit": {
                "type": "SelectVariable",
                "validVariableTypes": [
                  0
                ]
              }
            },
            {
              "caption": "Relais EIN = AUF",
              "name": "OpenRelayOn",
              "width": "125px",
              "add": false,
              "edit": {
                "type": "CheckBox"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Label",
      "caption": "S1Target: In der nativen Symcon-Instanz „LCN Variable / LCN Wert“ des jeweiligen neuen LCN-Moduls ausschließlich S1Target aktivieren und hier die Float-Variable „Zieltemperatur S1“ auswählen. Die zusätzlich erzeugte Boolean-Variable „Entriegelt“ nicht auswählen."
    },
    {
      "type": "ExpansionPanel",
      "caption": "Erweiterte Ablaufparameter",
      "expanded": false,
      "items": [
        {
          "type": "NumberSpinner",
          "name": "StepWaitMs",
          "caption": "Mindestwartezeit je Raum nach Tastendruck",
          "minimum": 900,
          "maximum": 3000,
          "suffix": " ms"
        },
        {
          "type": "NumberSpinner",
          "name": "MaxSteps",
          "caption": "Maximale Tastendrücke je Auftrag (Sicherheitsgrenze)",
          "minimum": 15,
          "maximum": 50
        },
        {
          "type": "NumberSpinner",
          "name": "NoChangeConfirmations",
          "caption": "Unveränderte bestätigte Schritte bis Kühl-Endlage",
          "minimum": 2,
          "maximum": 4
        }
      ]
    },
    {
      "type": "Label",
      "caption": "Die automatische Regelung arbeitet ausschließlich mit den laufenden S1Target-Rückmeldungen. Eine zyklische oder gebündelte LCN_RequestRead-Abfrage wird bewusst nicht verwendet, um den LCN-Bus nicht unnötig zu belasten."
    },
    {
      "type": "Label",
      "caption": "Heizen: Bedienbereich 18-24 Grad C und A7/A8 wie bisher. Kuehlen: Standard (Direkt-Aus) wie 0.2.10; Direkt-Ein nutzt bestaetigte LCN-Reglersperre und Relaisrueckmeldung. Bei Rueckmeldungsfehlern STOP und manuelle Pruefung."
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Laufenden Auftrag abbrechen",
      "onClick": "LCNC_Abort($id);"
    },
    {
      "type": "Button",
      "caption": "Fehlerstatus quittieren",
      "onClick": "LCNC_ClearError($id);"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Aktiv"
    },
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Keine aktiven Räume konfiguriert"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "Konfiguration fehlerhaft"
    },
    {
      "code": 202,
      "icon": "error",
      "caption": "Letzter LCN-Auftrag fehlgeschlagen"
    }
  ]
}
